@0 = ~[NWNM_11a] Their time has come. Destroy them all!~ [NWNM_11a] //Battle Cry 1
@1 = ~[NWNM_11b] Fall in behind me here.~ [NWNM_11b] //Becoming Leader
@2 = ~[NWNM_11c] Enough of this rushing about. I wish to stop and rest a while.~ [NWNM_11c] //Tired
@3 = ~[NWNM_11d] I trust we are going to move on eventually.~ [NWNM_11d] //Bored
@4 = ~[NWNM_11e] Healer. To my side. I require your services.~ [NWNM_11e] //Badly Wounded
@5 = ~[NWNM_11f] Yes?~ [NWNM_11f] //Selected 1
@6 = ~[NWNM_11g] What?~ [NWNM_11g] //Selected 2
@7 = ~[NWNM_11h] Wellll. Look what we have here.~ [NWNM_11h] //Selected 3
@8 = ~[NWNM_110] Hold a moment. I wish to share my thoughts with you.~ [NWNM_110] //Selected 4 (IWDEE)
@9 = ~[NWNM_11i] Very well.~ [NWNM_11i] //Action Acknowledgement 1
@10 = ~[NWNM_11j] That will require a mere fraction of my power.~ [NWNM_11j] //Action Acknowledgement 2
@11 = ~[NWNM_11k] Hmmm. An excellent suggestion.~ [NWNM_11k] //Action Acknowledgement 3
@12 = ~[NWNM_11s] Find something to do with yourself while I attend to this important matter.~ [NWNM_11s] //Action Acknowledgement 4
@13 = ~[NWNM_11t] I have better things to do.~ [NWNM_11t] //Action Acknowledgement 5
@14 = ~[NWNM_11u] Thank you for favoring us with that...pearl of wisdom.~ [NWNM_11u] //Action Acknowledgement 6
@15 = ~[NWNM_11v] Stand out of my way before I remove you by force.~ [NWNM_11v] //Action Acknowledgement 7
@16 = ~[NWNM_11l] Rrrghh.~ [NWNM_11l] //Being Hit
@17 = ~[NWNM_11m] Hrrrrrggh.~ [NWNM_11m] //Dying
@18 = ~[NWNM_118] Hahaha ha ha! Prepare to become one with eternity.~ [NWNM_118] //Battle Cry 2
@19 = ~[NWNM_119] Your end draws nigh.~ [NWNM_119] //Battle Cry 3
@20 = ~[NWNM_11x] How very amusing. Hmhmhmmm. Should I be afraid?~ [NWNM_11x] //Rare Select 1
@21 = ~[NWNM_11y] Defying me would be...unwise.~ [NWNM_11y] //Rare Select 2
@22 = ~[NWNM_11_] Hahaha ha ha!.~ [NWNM_11_] //Rare Select 3 (IWDEE)
@23 = ~[NWNM_11#] Halt here a moment.~ [NWNM_11#] //Rare Select 4 (IWDEE)
@24 = ~[NWNM_11z] Heh heh heh heheheh ha.~ [NWNM_11z] //Critical Hit Given
@25 = ~[NWNM_111] This is most...unfortunate.~ [NWNM_111] //Critical Miss
@26 = ~[NWNM_112] My weapon will not serve here.~ [NWNM_112] //Target Immune
@27 = ~[NWNM_113] I am overburdened. Perhaps you should bear some of my load.~ [NWNM_113] //Inventory Full
@28 = ~[NWNM_114] I thank you.~ [NWNM_114] //Successfully Picked A Pocket
@29 = ~[NWNM_115] In case it has escaped your attention, stealth is called for here.~ [NWNM_115] //Successfully Hid In Shadows
@30 = ~[NWNM_116] On second thought, I...have recanted my spell.~ [NWNM_116] //Spell Disrupted
@31 = ~[NWNM_117] I have completed this task.~ [NWNM_117] //Set A Trap
@32 = ~[NWNM_11w] Pray. To whatever gods you worship.~ [NWNM_11w] //Reaction to Party Member Death
