@0 = ~[NWNM_3a] By my direction, attack!~ [NWNM_3a] //Battle Cry 1
@1 = ~[NWNM_3b] I appreciate that. Thanks.~ [NWNM_3b] //Becoming Leader
@2 = ~[NWNM_3c] *Yawn* I need rest. Soon.~ [NWNM_3c] //Tired
@3 = ~[NWNM_3d] I need to get movin'. This is a waste of time.~ [NWNM_3d] //Bored
@4 = ~[NWNM_3e] I'm dying...This is not good.~ [NWNM_3e] //Badly Wounded
@5 = ~[NWNM_3f] Well met. Hello.~ [NWNM_3f] //Selected 1
@6 = ~[NWNM_3g] Yes. What is it?~ [NWNM_3g] //Selected 2
@7 = ~[NWNM_3h] I have something to say here.~ [NWNM_3h] //Selected 3
@8 = ~[NWNM_30] Hahahahahaha!~ [NWNM_30] //Selected 4 (IWDEE)
@9 = ~[NWNM_3i] I am certain.~ [NWNM_3i] //Action Acknowledgement 1
@10 = ~[NWNM_3j] I can do this.~ [NWNM_3j] //Action Acknowledgement 2
@11 = ~[NWNM_3k] That's a good thought. Good idea.~ [NWNM_3k] //Action Acknowledgement 3
@12 = ~[NWNM_3s] Follow me. Now.~ [NWNM_3s] //Action Acknowledgement 4
@13 = ~[NWNM_3t] Move aside, will you?~ [NWNM_3t] //Action Acknowledgement 5
@14 = ~[NWNM_3u] Scour this area. It should be closely examined.~ [NWNM_3u] //Action Acknowledgement 6
@15 = ~[NWNM_3v] No, I can't do that.~ [NWNM_3v] //Action Acknowledgement 7
@16 = ~[NWNM_3l] Oorghh.~ [NWNM_3l] //Being Hit
@17 = ~[NWNM_3m] Argh!~ [NWNM_3m] //Dying
@18 = ~[NWNM_38] No quarter!~ [NWNM_38] //Battle Cry 2
@19 = ~[NWNM_39] Time to die!~ [NWNM_39] //Battle Cry 3
@20 = ~[NWNM_3x] Everyone! Group here!~ [NWNM_3x] //Rare Select 1
@21 = ~[NWNM_3y] You just be careful! I'm warning you!~ [NWNM_3y] //Rare Select 2
@22 = ~[NWNM_3_] You act as my guard. Watch my back.~ [NWNM_3_] //Rare Select 3 (IWDEE)
@23 = ~[NWNM_3#] Bad idea. Not good at all.~ [NWNM_3#] //Rare Select 4 (IWDEE)
@24 = ~[NWNM_3z] Not bad! Not bad at all!~ [NWNM_3z] //Critical Hit Given
@25 = ~[NWNM_31] By the Hells!~ [NWNM_31] //Critical Miss
@26 = ~[NWNM_32] My weapon...ineffective. What..?!~ [NWNM_32] //Target Immune
@27 = ~[NWNM_33] Unnhh. This is too much to carry.~ [NWNM_33] //Inventory Full
@28 = ~[NWNM_34] Welll...have a look at this, here.~ [NWNM_34] //Successfully Picked A Pocket
@29 = ~[NWNM_35] Quietly now, into the shadows.~ [NWNM_35] //Successfully Hid In Shadows
@30 = ~[NWNM_36] Urgh. My magic has failed.~ [NWNM_36] //Spell Disrupted
@31 = ~[NWNM_37] I'm done with this.~ [NWNM_37] //Set A Trap
@32 = ~[NWNM_3w] Here! Fight me! Come on!~ [NWNM_3w] //Reaction to Party Member Death
