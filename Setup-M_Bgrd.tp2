VERSION ~1.01~

README ~M_Bgrd\Blackguard_ReadMe.txt~

//s9_soundsetBEGIN
//..................................
//Heres where you add your soundsets                          
//..................................

BEGIN ~M_Bgrd~
	OUTER_SPRINT soundName ~M_Bgrd~
	LAUNCH_ACTION_FUNCTION s9copy END
	INCLUDE ~M_Bgrd/baf/core.tpa~

/*  sample:

BEGIN ~Blank~                  												// Need to change "Blank" to whatever your guy is
	OUTER_SPRINT soundName ~Blank~    										// Need to change "Blank" to whatever your guy is
	LAUNCH_ACTION_FUNCTION s9copy END									    // stays the same
	INCLUDE ~M_Bgrd/baf/core.tpa~									// stays the same

*/
	